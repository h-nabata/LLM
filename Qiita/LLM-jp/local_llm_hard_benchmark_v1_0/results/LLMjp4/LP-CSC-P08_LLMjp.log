elf._access(u)\n        self._evert(u)\n        # now u is root, parity[u]==0, parity[v] holds the distance\n        return self.parity[v]\n\n    def component_odd(self, u):\n        \"\"\"return True iff the component containing u has an odd cycle\"\"\"\n        self._access(u)\n        self._evert(u)\n        return self.odd[u]\n\n\ndef solve() -> None:\n    data = sys.stdin.buffer.read().split()\n    it = iter(data)\n    n = int(next(it))\n    q = int(next(it))\n\n    lct = LinkCutTree(n)\n\n    out_lines = []\n    for _ in range(q):\n        typ = next(it).decode()\n        u = int(next(it))\n        v = int(next(it))\n        if typ == '+':\n            lct.link(u, v)\n        elif typ == '-':\n            lct.cut(u, v)\n        else:  # '?'\n            if not lct.same(u, v):\n                out_lines.append(\"DISCONNECTED\")\n            else:\n                if lct.component_odd(u):\n                    out_lines.append(\"CONTRADICTION\")\n                else:\n                    par = lct.get_parity(u, v)\n                    if par == 0:\n                        out_lines.append(\"SAME\")\n                    else:\n                        out_lines.append(\"DIFFERENT\")\n    sys.stdout.write(\"\\n\".join(out_lines))\n\n\nif __name__ == \"__main__\":\n    solve()\n",
