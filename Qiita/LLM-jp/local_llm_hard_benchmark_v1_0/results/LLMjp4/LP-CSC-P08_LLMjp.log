                "content": "import sys\n\nsys.setrecursionlimit(1 << 25)\n\n\nclass LinkCutTree:\n    def __init__(self, n):\n        self.n = n\n        self.ch = [[-1, -1] for _ in range(n + 1)]\n        self.fa = [-1] * (n + 1)\n        self.rev = [False] * (n + 1)\n        self.parity = [0] * (n + 1)          # parity to root (mod 2)\n        self.parity_rev = [0] * (n + 1)      # lazy parity to propagate\n        self.sz = [1] * (n + 1)\n        self.odd = [False] * (n + 1)         # component has odd cycle ?\n\n    # ---------- basic utilities ----------\n    def _push(self, x):\n        if self.rev[x]:\n            self.rev[self.ch[x][0]] = not self.rev[self.ch[x][0]]\n            self.rev[self.ch[x][1]] = not self.rev[self.ch[x][1]]\n            self.rev[x] = False\n            self.ch[x][0], self.ch[x][1] = self.ch[x][1], self.ch[x][0]\n\n        if self.parity_rev[x]:\n            self.parity_rev[self.ch[x][0]] ^= 1\n            self.parity_rev[self.ch[x][1]] ^= 1\n            self.parity[self.ch[x][0]] ^= 1\n            self.parity[self.ch[x][1]] ^= 1\n            self.parity_rev[x] = 0\n\n    def _pull(self, x):\n        self.sz[x] = 1\n        self.odd[x] = False\n        for i in (0, 1):\n            c = self.ch[x][i]\n            if c != -1:\n                self.sz[x] += self.sz[c]\n                self.odd[x] = self.odd[x] or self.odd[c]\n\n    # ---------- rotation ----------\n    def _rotate(self, x):\n        y = self.fa[x]\n        if self.fa[y] != -1:\n            self.ch[self.fa[y]][self.ch[self.fa[y]][1] == y] = x\n        self.fa[x] = self.fa[y]\n        self.ch[y][self.ch[y][0] == x] = x\n        self.fa[x] = y\n        # parity values stay unchanged \u2013 they already represent distance to the (new) root\n\n    def _splay(self, x):\n        while self.fa[x] != -1:\n            y = self.fa[x]\n            z = self.fa[y]\n            if z != -1:\n                if (self.ch[y][0] == x) == (self.ch[z][0] == y):\n                    self._rot